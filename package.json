    "dependency-cruiser": "^16.9.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "esbuild": "0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8",
    "yaml": "^2.7.0"
