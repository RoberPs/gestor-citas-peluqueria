    "db:seed:demo": "tsx db/seed/demo.ts",
    "db:seed:history": "tsx db/seed/history.ts",
    "owner:provision": "tsx scripts/provision-owner.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:integration && npm run test:contract && npm run test:e2e",
    "lint": "eslint . && tsc --noEmit",
    "check:layers": "depcruise src --config .dependency-cruiser.cjs",
