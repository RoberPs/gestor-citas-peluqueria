{
  "name": "gestor-citas-peluqueria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "next start",
    "db:migrate": "tsx scripts/migrate.ts",
