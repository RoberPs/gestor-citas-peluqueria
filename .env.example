# Copy to .env and fill in. No value in this file is a real secret (Principio V).

# PostgreSQL connection string for the application database.
DATABASE_URL=

# PostgreSQL connection string for the `db-test` service. Integration, contract
# and e2e suites truncate it between tests, so it must never point at `db`.
DATABASE_URL_TEST=

# IANA timezone of the salon. Configuration, not a system constant (asunción 9).
SALON_TIMEZONE=

# HMAC secret that turns a client IP into a non-reversible rate-limit key (FR-040).
# Fixed for the life of the process; rotate by restarting.
RATE_LIMIT_SECRET=

# Comma-separated proxy IPs whose `X-Forwarded-For` header is trusted (D-007).
TRUSTED_PROXY_IPS=

# Absolute base URL used to build the management link shown on the confirmation
# screen. It is the only delivery of that link (FR-015).
PUBLIC_BASE_URL=

# 002: only for `npm run owner:provision`, which creates or replaces the owner's
# account outside the application (FR-003). The running app never reads them.
# Single use: remove OWNER_INITIAL_PASSWORD from the server's environment as soon
# as the command has run. At least 12 characters.
OWNER_USERNAME=
OWNER_INITIAL_PASSWORD=
