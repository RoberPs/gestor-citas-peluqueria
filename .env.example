# Copy to .env and fill in. No value in this file is a real secret (Principio V).

# PostgreSQL connection string for the application database.
DATABASE_URL=

# PostgreSQL connection string for the `db-test` service. Integration, contract
# and e2e suites truncate it between tests, so it must never point at `db`.
DATABASE_URL_TEST=

# IANA timezone of the salon. Configuration, not a system constant (asunción 9).
SALON_TIMEZONE=

# HMAC secret that turns a client IP into a non-reversible rate-limit key (FR-040).
# Fixed for the life of the process; rotate by restarting.
RATE_LIMIT_SECRET=

# Comma-separated proxy IPs whose `X-Forwarded-For` header is trusted (D-007).
TRUSTED_PROXY_IPS=

# Absolute base URL used to build the management link shown on the confirmation
# screen. It is the only delivery of that link (FR-015).
PUBLIC_BASE_URL=

# 002: only for `npm run owner:provision`, which creates or replaces the owner's
# account outside the application (FR-003). The running app never reads them.
# Single use: remove OWNER_INITIAL_PASSWORD from the server's environment as soon
# as the command has run. At least 12 characters.
OWNER_USERNAME=
OWNER_INITIAL_PASSWORD=

# 004: the booking confirmation email (Principio IV). `on` or `off`; with `off`
# the app behaves exactly as it did before 004 and the booking form shows no
# consent checkbox. With `on`, EMAIL_API_KEY, EMAIL_FROM and NOTIFICATION_SEAL_KEY
# are required and the process refuses to start without them.
NOTIFICATIONS_EMAIL=off

# SMS has no adapter yet: only `off` is accepted (004, D-005).
NOTIFICATIONS_SMS=off

# Resend API key. Any value works against the fake provider (`npm run email:fake`).
EMAIL_API_KEY=

# Optional. Leave empty in production to use Resend's API; point it at the fake
# provider in development, e.g. http://127.0.0.1:4010.
EMAIL_API_BASE_URL=

# The sender address, on a domain verified with the provider. The salon's name
# is put in front of it as the display name.
EMAIL_FROM=

# Optional. Where a client's reply goes, usually the salon's own email.
EMAIL_REPLY_TO=

# 32 random bytes in base64 (`openssl rand -base64 32`). Encrypts the links of a
# confirmation while it is pending, at most one hour (004, D-002). Never reuse
# the development value in production.
NOTIFICATION_SEAL_KEY=
